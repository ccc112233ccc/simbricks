{
  "simulators": [
    {
      "name": "basicmem",
      "exec": "./sims/mem/basicmem/basicmem",
      "args": ["1024", "0", "0", "1", "0", "10", "10"],
      "ports": [{"name": "mem"}]
    },
    {
      "name": "memstim",
      "exec": "./sims/mem/memstim/memstim",
      "args": ["0", "0", "4", "8", "1", "0", "10", "10"],
      "ports": [{"name": "mem"}]
    }
  ],
  "links": [
    {
      "a": "memstim.mem",
      "b": "basicmem.mem",
      "channel": {
        "type": "shm_ring",
        "options": {
          "socket_path": "./mem.socket",
          "shm_path": "./mem.shm",
          "entries": 8192,
          "entry_size": 8256
        }
      }
    }
  ]
}
